# ========================================================
# Imagify Environment Configuration Reference
# ========================================================
# Note: This project is separated into `client` and `server`.
# Ensure your environment variables are configured in:
#  - server/.env (for backend services, database, APIs)
#  - client/.env (for frontend Vite client)
# ========================================================

# --- SERVER (server/.env) ---
# PORT=4000
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>
# JWT_SECRET=your_jwt_secret_key_here
# CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
# CLOUDINARY_API_KEY=your_cloudinary_api_key
# CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# RAZORPAY_KEY_ID=rzp_test_your_key_id
# RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# CURRENCY=INR

# --- CLIENT (client/.env) ---
# VITE_BACKEND_URL=http://localhost:4000
# VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id
