# ==========================================
# Imagify Backend Environment Variables
# ==========================================

# Server Port
PORT=4000

# MongoDB Connection String (e.g. MongoDB Atlas URI)
# Note: Mongoose connects to `${MONGODB_URI}/imagify`
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>

# JSON Web Token Secret for user authentication
JWT_SECRET=your_jwt_secret_key_here

# Cloudinary Credentials (for AI generation, background removal, enhance, etc.)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Credentials (for credit purchase / payments)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
CURRENCY=INR
